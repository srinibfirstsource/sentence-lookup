# Directory where built indexes are stored
INDEX_DIR=./data/index

# Path to the source corpus CSV (columns: id, sentence, code)
CORPUS_CSV_PATH=./data/corpus.csv

# Minimum fuzzy match score (0-100) to accept a result
FUZZY_THRESHOLD=75

# Max candidates to retrieve from SQLite FTS5 for fuzzy ranking
MAX_FUZZY_CANDIDATES=50

# Rows per chunk when reading corpus CSV
CHUNK_SIZE=100000

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# FastAPI server host
API_HOST=0.0.0.0

# FastAPI server port
API_PORT=8000

# Number of uvicorn workers
WORKERS=4

# Enable fuzzy fallback (Stage 2)
ENABLE_FUZZY=true

# Maximum queries per /search/batch request
MAX_BATCH_SIZE=1000
